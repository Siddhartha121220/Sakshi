# Copy to .env and fill in. See src/config.ts for validation and defaults.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (docs/DATABASE.md). Point this at a real Postgres for dev/prod — see README.md for how
# tests instead use an embedded PGlite stand-in with no setup required.
DATABASE_URL=postgres://user:password@localhost:5432/sakshi

# Chain (docs/ARCHITECTURE.md §6): local=31337 (Anvil), staging=84532 (Base Sepolia), prod=8453 (Base)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
SAKSHI_ANCHOR_CONTRACT=0x0000000000000000000000000000000000000000
# Required by the anchor worker only (apps/api src/worker.ts), not the API server.
ANCHORER_PRIVATE_KEY=

# Anchor worker tuning (defaults shown)
ANCHOR_INTERVAL_MS=300000
ANCHOR_MAX_BATCH_SIZE=10000
ANCHOR_STUCK_TX_TIMEOUT_MS=180000
FINALITY_FALLBACK_CONFIRMATIONS=1

# Device registration (docs/PROTOCOL.md §2)
SERVER_CHALLENGE_SECRET=change-me-to-a-random-string-at-least-16-bytes
CHALLENGE_TTL_SECONDS=600
ALLOWED_APP_PACKAGE=app.sakshi
# Comma-separated lowercase hex sha256 digests of the Android app's signing certificate(s). For a debug
# build this is YOUR machine's debug key — read it off the APK:
#   $ANDROID_HOME/build-tools/<ver>/apksigner verify --print-certs app-debug.apk   (the SHA-256 line)
ALLOWED_APP_CERT_DIGESTS=

# Dev-only: bypasses real Android Key Attestation so a software "fake device" can register.
# MUST stay false/unset outside development — refused outright when NODE_ENV=production.
DEV_SKIP_ATTESTATION=false
