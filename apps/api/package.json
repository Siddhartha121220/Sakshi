{
  "name": "@sakshi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:db": "tsx scripts/dev-db.ts",
    "dev:all": "tsx src/serve-all.ts",
    "start": "tsx src/serve-all.ts",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "fake-device": "tsx scripts/fake-device.ts",
    "db:migrate": "dbmate --no-dump-schema up",
    "db:rollback": "dbmate down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@peculiar/asn1-android": "^2.10.0",
    "@peculiar/asn1-schema": "^2.3.15",
    "@peculiar/x509": "^2.1.0",
    "@sakshi/core": "workspace:*",
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "viem": "^2.57.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.0.0",
    "dbmate": "^2.36.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
